# =====================================================================
#  Azaria API — variables d'environnement de PRODUCTION
#  Copier vers /opt/azaria/shared/.env sur le serveur, puis remplir.
#  chmod 600 (secrets). Ne jamais committer ce fichier rempli.
# =====================================================================

# --- Node / runtime ---
NODE_ENV=production
TZ=Africa/Lubumbashi
# L'API n'écoute qu'en local : Nginx fait le pont vers l'extérieur (TLS).
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# --- App ---
# Générer avec :  node ace generate:key   (dans le dossier build/)
APP_KEY=
APP_URL=https://api.azaria.cd

# --- Session ---
SESSION_DRIVER=cookie

# --- PostgreSQL (base DÉJÀ en place) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=azaria
DB_PASSWORD=__mot_de_passe_db__
DB_DATABASE=azaria_db

# --- CORS : origines navigateur autorisées (admin + client), séparées par des virgules ---
# INDISPENSABLE en prod : sans ça, le temps réel (SSE) et les appels front sont bloqués.
CORS_ORIGIN=https://admin.azaria.cd,https://azaria.cd

# --- Compte administrateur initial (seeder idempotent, une seule fois) ---
ADMIN_EMAIL=admin@azaria.cd
ADMIN_PASSWORD=__mot_de_passe_admin_fort__
ADMIN_NAME=Administrateur Azaria

# --- Cloudinary (images plats / accompagnements) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp Cloud API (Meta) — suivi client. Laisser vide = envois « skipped ». ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANG=fr

# --- Telegram — alertes internes équipe (optionnel) ---
TELEGRAM_BOT_TOKEN=

# --- URLs publiques (liens insérés dans les messages WhatsApp/Telegram) ---
CUSTOMER_APP_URL=https://azaria.cd
ADMIN_APP_URL=https://admin.azaria.cd
