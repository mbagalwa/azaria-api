# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=azaria_db

# Compte administrateur par défaut (seeder)
ADMIN_EMAIL=admin@azaria.cd
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrateur Azaria

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4320,http://localhost:3000