# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=azaria_db

# Compte administrateur par défaut (seeder)
ADMIN_EMAIL=admin@azaria.cd
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrateur Azaria

#--------------------------------------------------------------------
# Cloudinary (images des plats et des accompagnements)
#--------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#--------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — suivi du client, canal principal
#
# Sans jeton, les envois sont journalisés en « skipped » : l'application
# fonctionne, mais le client ne reçoit rien. Pour l'activer :
#   1. Compte Meta Business + application « WhatsApp » ;
#   2. numéro expéditeur vérifié → son PHONE_NUMBER_ID ;
#   3. jeton d'accès permanent (utilisateur système) ;
#   4. templates approuvés (obligatoires hors fenêtre de service de 24 h),
#      à renseigner ensuite dans Admin → Paramètres → Notifications.
#--------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANG=fr

#--------------------------------------------------------------------
# Telegram — alertes internes de l'équipe (nouvelle commande)
# Jeton donné par @BotFather ; le chat destinataire se règle dans
# Admin → Paramètres → Notifications.
#--------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

#--------------------------------------------------------------------
# URLs publiques (liens insérés dans les messages envoyés)
#--------------------------------------------------------------------
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:4320

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4320,http://localhost:3002
